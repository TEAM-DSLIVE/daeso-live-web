# Backend API origin (with or without https://)
VITE_SERVER_URL=http://localhost:8080
# VITE_API_BASE_URL=http://localhost:8080
# Vercel: true. AID release: false.
VITE_USE_API_PROXY=false
# AID release HTTP API origin. Leave empty for local development.
VITE_HTTP_API_BASE_URL=

# Local development only. Never commit a real token.
VITE_DAESO_LIVE_AID_TOKEN=
